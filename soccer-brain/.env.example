# Copy to .env — every value is optional. Nothing paid is used unless you set a key AND pick that provider.

# Narration: kokoro (default, free/local) | piper (free/local) | openai | elevenlabs | google
SB_TTS_PROVIDER=kokoro
# SB_TTS_VOICE=am_michael

# Branding
SB_CHANNEL_NAME=Soccer Brain
# SB_CHANNEL_HANDLE=@soccerbrain

# Optional paid TTS (estimates are shown in the studio before use)
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=tts-1-hd
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_IDS=Adam:pNInz6obpgDQGcFmaJgB
# GOOGLE_TTS_API_KEY=

# Paths (defaults shown)
# SB_MASTER_LIST=../players.json      # the curated master list
# SB_DATA_DIR=./data
# SB_OUTPUT_DIR=./output
# SB_MODELS_DIR=./models

# Rendering
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell   # auto-detected if unset
# SB_RENDER_CONCURRENCY=4

# Facts: how many days a confirmed "current club" stays trusted for clues
# SB_CURRENT_CLUB_MAX_AGE_DAYS=120
